[Unit]
Description=Passive SLAM MAVLink health monitor
After=multi-user.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
SupplementaryGroups=dialout
WorkingDirectory=__WORKDIR__
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 __WORKDIR__/src/main.py --config __WORKDIR__/config.yaml
Restart=always
RestartSec=3
Nice=5

[Install]
WantedBy=multi-user.target
