[Unit]
Description=Jetson SLAM ODOMETRY bridge for Cube
After=intellisense_usb_serial_sensors.service
Wants=intellisense_usb_serial_sensors.service
ConditionPathExists=__WORKDIR__/config/autostart.yaml

[Service]
Type=simple
User=__USER__
Group=__GROUP__
SupplementaryGroups=dialout video render plugdev i2c
WorkingDirectory=__WORKDIR__
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/env python3 __WORKDIR__/scripts/run_slam_odometry_bridge.py --config __WORKDIR__/config/autostart.yaml
Restart=always
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
