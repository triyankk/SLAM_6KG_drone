[Unit]
Description=optFlow JT16 obstacle-avoidance-only runtime
After=default.target

[Service]
Type=simple
WorkingDirectory=%h/vscode/optFlow_slam
ExecStart=%h/vscode/optFlow_slam/scripts/run_obstacle_avoidance_service.sh
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=20
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
